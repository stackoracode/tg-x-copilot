# Copy to .env (chmod 600) and fill in. Nested settings use "__" (e.g. CPA__BASE_URL).
# Keys marked [runtime] can later be overridden from the admin UI (stored in MySQL).
# API keys / credentials are ENV-ONLY: they are never editable at runtime or stored in MySQL.
# Comments are on their own lines on purpose (inline comments confuse some dotenv parsers).

LOG_LEVEL=INFO
# false = human-readable lines (nice for `journalctl -f`)
LOG_JSON=true
# [runtime]
DEFAULT_LOCALE=en-US
# [runtime]
MARKET=US
SHUTDOWN_GRACE_SECONDS=30

# --- Telegram: api_id/api_hash from https://my.telegram.org, token from @BotFather
TELEGRAM__ENABLED=true
TELEGRAM__API_ID=123456
TELEGRAM__API_HASH=replace_me
TELEGRAM__BOT_TOKEN=123456789:replace_me
TELEGRAM__SESSION_PATH=data/bot.session
# JSON list of Telegram user IDs allowed to use the bot (empty = nobody)
TELEGRAM__ALLOWED_USER_IDS=[11111111]

# --- CPA proxy (OpenAI-compatible): text, vision and image models   [runtime except API_KEY]
CPA__BASE_URL=http://127.0.0.1:8317/v1
CPA__API_KEY=replace_me
CPA__TIMEOUT_SECONDS=90
CPA__MAX_RETRIES=3

# --- Jev = TypeSafe AI System One API (typed scoring/routing, NOT a chat model)
# [runtime except API_KEY]. Optional: disabled, unconfigured, slow or failing Jev falls back
# to the main LLM instead of failing the task.
JEV__ENABLED=true
# Docs: https://docs.typesafe.ai/api  (Bearer auth, GET /v1/models, POST /v1/systemone)
JEV__BASE_URL=https://api.typesafe.ai/v1
JEV__API_KEY=replace_me
JEV__MODEL=jev-latest
JEV__TIMEOUT_SECONDS=15
JEV__MAX_RETRIES=1
# Hard wall-clock budget for the whole Jev step; on expiry the main LLM decides.
JEV__BUDGET_SECONDS=30
# Below this confidence Jev's value judgment is not trusted; the main LLM decides.
JEV__CONFIDENCE_FLOOR=0.6
# A confident value score (0..1) below this skips the task.
JEV__MIN_VALUE=0.4
# Noul probability thresholds.
JEV__PROMO_SKIP=0.8
JEV__RISK_REVIEW=0.6
JEV__MEDIA_USEFUL_MIN=0.3

# --- Main models via CPA   [runtime]
MODELS__TEXT_MODEL=gpt-5
MODELS__VISION_MODEL=gpt-5
MODELS__IMAGE_MODEL=gpt-image-2
MODELS__IMAGE_SIZE=1024x1024
# edits | generations_with_refs (for relays without /images/edits)
MODELS__IMAGE_EDIT_MODE=edits
MODELS__JSON_MODE=true
# Leave unset for reasoning models that reject non-default temperature.
# MODELS__TEXT_TEMPERATURE=0.7

# --- Cloudflare R2 (Standard storage)   [runtime except the two keys]
R2__ACCOUNT_ID=replace_me
R2__ACCESS_KEY_ID=replace_me
R2__SECRET_ACCESS_KEY=replace_me
R2__BUCKET=tg-x-copilot
R2__STORAGE_CLASS=STANDARD
# Optional custom domain; otherwise the admin UI uses presigned URLs.
R2__PUBLIC_BASE_URL=

# --- Storage policy (10 GB free tier)   [runtime]
# Keep compressed copies of images flagged for review (deleted on approve/reject). Off by
# default: the originals stay in the Telegram chat.
STORAGE__PERSIST_REVIEW_MEDIA=false
# Keep final assets in R2 after approval (long-term retention). Off by default: they were
# already delivered to Telegram with the draft, so approval frees them.
STORAGE__RETAIN_APPROVED_ASSETS=false
# Soft budget in bytes (9 GiB); uploads beyond it are refused and flagged.
STORAGE__BUDGET_BYTES=9663676416
STORAGE__PHOTO_MAX_SIDE=2048
STORAGE__GRAPHIC_MAX_SIDE=4096
STORAGE__JPEG_QUALITY=85

# --- MySQL (bootstrap only)
DB__HOST=127.0.0.1
DB__PORT=3306
DB__USER=tgx
DB__PASSWORD=replace_me
DB__DATABASE=tg_x_copilot

# --- Concurrency (one semaphore per workload)
CONCURRENCY__WORKERS=3
CONCURRENCY__QUEUE_MAXSIZE=200
CONCURRENCY__JEV=4
CONCURRENCY__TEXT=2
CONCURRENCY__VISION=2
CONCURRENCY__IMAGE=1
CONCURRENCY__DB=5
CONCURRENCY__IO=4

# --- Pipeline   [runtime except TASK_TIMEOUT/MAX_MEDIA_BYTES]
PIPELINE__MAX_REWRITE_ATTEMPTS=3
PIPELINE__TASK_TIMEOUT_SECONDS=900
PIPELINE__MAX_MEDIA_BYTES=20971520
# Channel IDs whose media you own, e.g. [-1001234567890]
PIPELINE__OWNED_SOURCE_IDS=[]
PIPELINE__DIRECT_UPLOADS_OWNED=false

# --- Admin web UI (bind to localhost; use an SSH tunnel)
ADMIN__HOST=127.0.0.1
ADMIN__PORT=8080
ADMIN__USERNAME=admin
ADMIN__PASSWORD=replace_me
